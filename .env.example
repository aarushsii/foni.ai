# Copy this file to .env and fill in your keys. Never push .env to GitHub.

# Nicrron: nicrron.ai/dashboard/keys
NICRRON_API_KEY=

# PRISM: Settings -> Project (project ID) and Settings -> API Keys (key)
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=

# Fony settings
FONY_MODEL=nicrron/auto
FONY_VERSION=v2
FONY_THRESHOLD=50
